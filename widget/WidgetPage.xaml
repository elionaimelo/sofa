<Page
    x:Class="Sofa.Widget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="#1B2029">
    <Grid>
        <controls:WebView2 x:Name="View" DefaultBackgroundColor="#1B2029"
                           NavigationCompleted="View_NavigationCompleted" />
        <!-- Shown when Sofa isn't running (the HUD is served by the app itself). -->
        <StackPanel x:Name="Offline" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Padding="24">
            <TextBlock Text="Sofa is not running" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock Text="Open Sofa to use the HUD." Foreground="#B9BEC9" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Retry" HorizontalAlignment="Center" Click="Retry_Click" />
        </StackPanel>
    </Grid>
</Page>
